{
  "name": "vittix-seo-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Professional, privacy-first, open-source SEO auditing toolkit for Chrome.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @vittix/extension dev",
    "build": "pnpm -r build",
    "build:chrome": "pnpm --filter @vittix/extension build:chrome",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build:chrome && pnpm --filter @vittix/extension build:e2e && playwright test",
    "clean": "pnpm -r clean",
    "icons": "node scripts/generate-icons.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "zip": "pnpm build:chrome && pnpm notices && pnpm --filter @vittix/extension zip",
    "notices": "node scripts/generate-notices.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
