{
  "name": "@vittix/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vittix SEO Toolkit — Chrome extension (WXT + React + Tailwind CSS 4).",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build -b chrome",
    "build:chrome": "wxt build -b chrome",
    "build:e2e": "wxt build -b chrome -c wxt.config.e2e.ts",
    "zip": "node ../../scripts/package-zip.mjs",
    "typecheck": "wxt prepare && tsc --noEmit",
    "clean": "wxt clean"
  },
  "dependencies": {
    "@vittix/seo-core": "workspace:*",
    "@vittix/shared": "workspace:*",
    "dexie": "4.4.7",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "tailwindcss": "4.3.3",
    "vite": "7.3.7",
    "wxt": "0.21.5"
  }
}
